{
  "manifest_version": 3,
  "name": "Olos Call Alert",
  "version": "2.2",
  "description": "Alerta para chamadas recebidas no Olos.",
  "permissions": [
    "notifications",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://bbts.oloschannel.com.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Parar ring",
    "default_icon": "icon_light_mode.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bbts.oloschannel.com.br/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ring.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon_light_mode.png",
    "32": "icon_light_mode.png",
    "48": "icon_light_mode.png",
    "128": "icon_light_mode.png"
  }
}